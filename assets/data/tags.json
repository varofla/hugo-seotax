{{- $json := dict -}}
{{- $pages := partialCached "pages/search" . "search" -}}
{{- /* Get unique tags */ -}}
{{- $tags := slice -}}
{{- range $page := $pages -}}
  {{- range partial "content/tags" $page -}}
    {{- $tags = $tags | append . -}}
  {{- end -}}
{{- end -}}
{{- /* Create tags map with name and post IDs */ -}}
{{- range $t := sort (uniq $tags) -}}
  {{- $ids := slice -}}
  {{- range $id, $page := $pages -}}
    {{- if in (partial "content/tags" $page) $t -}}
      {{- $ids = $ids | append $id -}}
    {{- end -}}
  {{- end -}}
  {{- $tag := dict "name" $t "ids" $ids -}}
  {{- $json = $json | merge (dict (lower $t) $tag) -}}
{{- end -}}
{{- /* Return the tags map as JSON */ -}}
{{- $json | jsonify -}}